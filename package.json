{
  "name": "quiz",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "concurrently -k -n worker,web -c blue,green \"npm run dev -w @quiz/worker\" \"npm run dev -w @quiz/web\"",
    "content:validate": "node scripts/content/validate.ts",
    "content:build": "node scripts/content/build.ts",
    "content:draft": "node scripts/content/draft.ts",
    "content:critique": "node scripts/content/critique.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/worker && tsc --noEmit -p apps/web",
    "test": "vitest run",
    "smoke": "node scripts/dev/smoke.ts",
    "analytics": "node scripts/dev/analytics-report.ts",
    "db:migrate:local": "npm run db:migrate:local -w @quiz/worker",
    "deploy:staging": "npm run build -w @quiz/web && npm run deploy:staging -w @quiz/worker",
    "deploy:production": "npm run build -w @quiz/web && npm run deploy:production -w @quiz/worker",
    "content:review": "node scripts/content/review.ts",
    "content:priority": "node scripts/dev/simulate.ts --priority",
    "content:priority:saturday": "node scripts/dev/simulate.ts --only saturday --runs 300 --priority"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
