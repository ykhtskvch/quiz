{
  "name": "@quiz/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply quiz-analytics --local",
    "deploy:staging": "wrangler deploy --env staging",
    "db:migrate:staging": "wrangler d1 migrations apply quiz-analytics-staging --env staging --remote",
    "deploy:production": "wrangler deploy --env production",
    "db:migrate:production": "wrangler d1 migrations apply quiz-analytics --env production --remote"
  },
  "dependencies": {
    "@quiz/shared": "*",
    "hono": "^4.13.12",
    "@quiz/engine": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "wrangler": "^4.146.0"
  }
}
