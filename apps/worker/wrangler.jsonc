{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "quiz",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  // Anonymous analytics. Local dev only needs the name (npm run db:migrate:local).
  "d1_databases": [
    { "binding": "DB", "database_name": "quiz-analytics", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "observability": { "enabled": true },
  // Per-IP limits (NFR-016). A whole party usually shares one Wi-Fi IP, so the room limit is generous:
  // 8 phones + display reconnecting after a blip stay well under it, while guessing 32^6 codes stays hopeless.
  "ratelimits": [
    { "name": "RL_CREATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_ROOM", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_ACTION", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } }
  ],

  "env": {
    // https://quiz-staging.<account>.workers.dev — playtests (12-system-design §12).
    // The worker serves the built web app; /api/* goes to the worker first.
    "staging": {
      "name": "quiz-staging",
      "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "quiz-analytics-staging",
          "database_id": "4a119122-04b1-457e-8fe0-1dc3fe241d13",
          "migrations_dir": "migrations"
        }
      ],
      "observability": { "enabled": true },
      "ratelimits": [
        { "name": "RL_CREATE", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_ROOM", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_ACTION", "namespace_id": "2003", "simple": { "limit": 300, "period": 60 } }
      ]
    }
  }
}
